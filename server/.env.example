PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/sunaina-clinic
CLIENT_URL=http://localhost:5173,https://sunaina-clinic.vercel.app

# Resend (https://resend.com) — HTTPS API, no SMTP.
RESEND_API_KEY=

# RESEND_FROM must be an address on a domain verified in Resend
# (Resend > Domains). A gmail.com / yahoo.com / etc. address will
# always fail with "domain is not verified" because Resend does not
# let you send FROM a domain you don't own.
#   Production:  notifications@yourverifieddomain.com
#   Local/dev only (no domain verified yet): onboarding@resend.dev
#     — Resend's shared test sender. It only delivers to the email
#       address of the Resend account owner, so it's fine for local
#       testing but must NOT be used in production.
RESEND_FROM=

# CLINIC_EMAIL is the destination inbox that receives callback
# requests. This may be a Gmail address (Gmail is fine as a
# recipient — it just can't be used as RESEND_FROM).
CLINIC_EMAIL=
